APP_ENV=development

# FastAPI API 환경 변수
PROJECT_NAME=NextWave
API_V1_STR=/api/v1
# MYSQL_USER:MYSQL_PASSWORD@db:3306/MYSQL_DATABASE
DATABASE_URL=mysql+pymysql://nextwave_user:your_user_password_here@db:3306/nextwave

SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxxx...
LLM_BASE_URL=http://[IP_ADDRESS]/v1
TZ=Asia/Seoul